# SpeakUp LMS — Required Environment Variables
# Copy this file to .env.local and populate with your production credentials.
# NEVER commit .env.local or real secrets to GitHub or any public repository.

# ==========================================
# 1. Supabase Database & Auth (Mandatory)
# ==========================================
# Public credentials (used by browser client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Administrative Server-Only Secret (NEVER expose to client code or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ==========================================
# 2. Transactional Email Service (Resend)
# ==========================================
RESEND_API_KEY=re_your_resend_api_key_here
PORTAL_CONTACT_EMAIL=info@speakup.edu.pk

# ==========================================
# 3. AI Providers & Chatbot (Optional - Can also be set in Admin Panel)
# ==========================================
# OpenAI API credentials
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Gemini API credentials
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ==========================================
# 4. WhatsApp & Meta Messaging (Optional - Can also be set in Admin Panel)
# ==========================================
# WhatsApp Business Platform Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token

# Meta / Facebook Graph API
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token

# ==========================================
# 5. Local Testing & Diagnostics (Optional - Development Only)
# ==========================================
# TEST_STUDENT_EMAIL=student@example.com

